{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovalRequest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "action_type": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "max_spend": {
      "type": [
        "number",
        "null"
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration": {
      "type": [
        "string",
        "null"
      ]
    },
    "rollback_or_pause": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "executed",
        "failed"
      ]
    }
  },
  "required": [
    "id",
    "action_type",
    "target",
    "summary",
    "status"
  ],
  "additionalProperties": true
}

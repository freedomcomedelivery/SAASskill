{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectState",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "enum": [
        "intake",
        "personal_concept",
        "market_discovery",
        "idea_generation",
        "idea_selection",
        "research_marketing",
        "offer_landing",
        "gtm_planning",
        "launch",
        "lead_onboarding",
        "iteration_tracking",
        "scale_or_pivot",
        "audit_intake",
        "audit_snapshot",
        "audit_market_positioning",
        "audit_offer_landing",
        "audit_acquisition",
        "audit_funnel_sales",
        "audit_economics",
        "audit_growth_plan",
        "audit_execution",
        "audit_iteration",
        "audit_growth_loop"
      ]
    },
    "runtime_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "personal_concept": {
      "type": [
        "object",
        "null"
      ]
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ideas": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "selected_idea_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "research": {
      "type": [
        "object",
        "null"
      ]
    },
    "marketing_contract": {
      "type": [
        "object",
        "null"
      ]
    },
    "landing_brief": {
      "type": [
        "object",
        "null"
      ]
    },
    "economics": {
      "type": [
        "object",
        "null"
      ]
    },
    "channel_plan": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "leads": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "funnel_snapshots": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "iterations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "action_log": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "pending_tool_requests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tool_results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "workflow": {
      "enum": [
        "greenfield",
        "existing_project_audit"
      ]
    },
    "audit_snapshot": {
      "type": [
        "object",
        "null"
      ]
    },
    "audit_report": {
      "type": [
        "object",
        "null"
      ]
    },
    "growth_plan": {
      "type": [
        "object",
        "null"
      ]
    },
    "selected_growth_action_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "commercial_readiness": {
      "enum": [
        "unknown",
        "not_ready",
        "ready_for_controlled_sales",
        "sales_validated",
        "ready_to_scale"
      ]
    }
  },
  "required": [
    "project_id",
    "stage"
  ],
  "additionalProperties": true
}

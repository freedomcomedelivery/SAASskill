{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicParserRequest",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "max_pages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25
    },
    "max_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "delay_seconds": {
      "type": "number",
      "minimum": 0
    },
    "allowed_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "url"
  ],
  "additionalProperties": false
}

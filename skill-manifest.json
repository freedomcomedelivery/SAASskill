{
  "name": "pet-project-launch-operator",
  "version": "1.4.0",
  "language": "ru",
  "entrypoint": "SKILL.md",
  "runtime": {
    "package": "saasskill",
    "python": ">=3.10",
    "cli": "saasskill",
    "mcp_entrypoint": "saasskill-mcp",
    "state_store": ".saasskill/projects/<project_id>/state.json",
    "runner": "project_tick"
  },
  "hosts": {
    "mcp": true,
    "claude_code": {
      "local_stdio": true,
      "remote_http": true
    },
    "claude_platform": {
      "remote_mcp": true
    },
    "openai": {
      "remote_mcp": true
    }
  },
  "providers": {
    "research": [
      "web",
      "semrush",
      "ahrefs"
    ],
    "actions": [
      "ads"
    ],
    "metrics": [
      "ads",
      "analytics",
      "crm"
    ]
  },
  "source_methodology": "Практикум по пет-проектам, May 2026 materials supplied by user",
  "artifacts": [
    "project_state",
    "evidence",
    "market",
    "idea",
    "research_pack",
    "marketing_contract",
    "landing_brief",
    "economics",
    "channel_plan",
    "approval_request",
    "lead_record",
    "funnel_snapshot",
    "iteration",
    "audit_snapshot",
    "audit_report",
    "growth_plan",
    "commercial_readiness"
  ],
  "channels": [
    "search",
    "meta",
    "telegram",
    "google_display",
    "rsya",
    "marketplace",
    "outreach",
    "product_hunt",
    "content",
    "avito",
    "app_store_asa"
  ],
  "workflows": {
    "greenfield": [
      "intake",
      "personal_concept",
      "market_discovery",
      "idea_generation",
      "idea_selection",
      "research_marketing",
      "offer_landing",
      "gtm_planning",
      "launch",
      "lead_onboarding",
      "iteration_tracking",
      "scale_or_pivot"
    ],
    "existing_project_audit": [
      "audit_intake",
      "audit_snapshot",
      "audit_market_positioning",
      "audit_offer_landing",
      "audit_acquisition",
      "audit_funnel_sales",
      "audit_economics",
      "audit_growth_plan",
      "audit_execution",
      "audit_iteration",
      "audit_growth_loop"
    ]
  }
}
